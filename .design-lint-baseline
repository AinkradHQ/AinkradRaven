# design-lint baseline. Counts only go down: `make lint` lowers them.
# Raising one needs `make lint-rebaseline`, DESIGN_LINT_ALLOW_RAISE=1 on push, and a PR note.
version 1
format off
font-size 0
padding-literal 0
spacing-literal 0
radius-literal 0
hex-color 0
raw-color 0
raw-control 0
file-length 0
try-bang 0
force-cast 0
force-unwrap 0
print 0
opacity-literal 0
frame-literal 0
chamfer-literal 0
motion-literal 0
chamfer-direct 0
